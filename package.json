{
  "name": "gyomu-file-kenshin",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keiru-dev/gyomu-file-kenshin.git"
  },
  "type": "module",
  "description": "業務ファイル健診 — オフライン単一HTMLのExcelブック診断ツール（通信を行わない）",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run verify",
    "verify": "node scripts/verify-artifact.mjs",
    "browser-check": "node --experimental-websocket scripts/browser-check.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "fixtures": "vite-node fixtures/generate.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "vite-node fixtures/demo.ts",
    "perf": "vite-node fixtures/perf.ts",
    "firefox-check": "node --experimental-websocket scripts/firefox-check.mjs",
    "dist": "npm run build && node scripts/make-dist.mjs",
    "calibrate": "vite-node fixtures/calibrate.ts"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz"
  }
}
